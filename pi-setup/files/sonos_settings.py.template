# Generated by pi-setup/setup.sh. sonos_settings.py is gitignored, so this
# template is the source of truth. Spotify keys are filled in at setup time.

sonos_http_api_address = "localhost"
sonos_http_api_port = "5005"

log_file = "~/music-screen-api.log"
log_level = "INFO"

demaster = True
demaster_query_cloud = False

# From https://developer.spotify.com/dashboard (any app works; keep these private)
spotify_client_id = "__SPOTIFY_CLIENT_ID__"
spotify_client_secret = "__SPOTIFY_CLIENT_SECRET__"
spotify_market = "US"
show_spotify_code = False
show_spotify_albumart = True     # use Spotify art instead of the SiriusXM channel logo

room_name_for_highres = "Kitchen"

show_details = False
show_details_timeout = 10
show_artist_and_album = True
artist_and_album_newlook = True  # required for SiriusXM track parsing
overlay_text = True
use_font_family = "Consolas"
show_play_state = True

sleep_on_tv = False
sleep_on_linein = False
pi_zero = False
